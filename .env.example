# Copy this file to .env.local and fill in the values for your local environment.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; keep secrets unprefixed.

NEXT_PUBLIC_APP_URL=

# Sentry (widgets/telemetry) — unset means telemetry stays a no-op.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (widgets/analytics) — unset means analytics stays a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

#Chromatic (storybook) — unset means Chromatic is disabled.
CHROMATIC_PROJECT_TOKEN=
# Contact form (components/landing/closing/contact-form) — unset means the form shows an error instead of sending.
# CONTACT_EMAIL_FROM must use a domain verified in Resend (or onboarding@resend.dev while testing).
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
